# Service definition to execute an Objective.

# The name of the Objective.
string objective_name

# All parameters required by the given Objective.
moveit_studio_sdk_msgs/BehaviorParameter[] parameter_overrides

# Caller-declared identity. Zero/empty values mean unspecified.
moveit_studio_sdk_msgs/ObjectiveCaller caller
---
# 1 if successful, otherwise an error code.
moveit_msgs/MoveItErrorCodes error_code
