# goal

# Set exactly one of `objective_name` or `objective_xml_string`. The request is rejected
# if both are populated or if both are empty.

# The name of the objective to run.
string objective_name

# The raw behavior tree xml as a string.
string objective_xml_string

# Default values of named parameters in the predefined objective will be overridden by the values provided in `parameter_overrides` below.
moveit_studio_sdk_msgs/BehaviorParameter[] parameter_overrides

# Caller-declared identity. Zero/empty values mean unspecified.
moveit_studio_sdk_msgs/ObjectiveCaller caller
---
# result
moveit_msgs/MoveItErrorCodes error_code
string error_message
---
#feedback (empty)
